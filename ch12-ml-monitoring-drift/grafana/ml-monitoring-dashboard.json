{
  "title": "ML Monitoring: anomaly-detector",
  "uid": "ml-monitoring-anomaly-detector",
  "schemaVersion": 39,
  "tags": ["mlops", "drift", "ch12"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Estimated ROC AUC (CBPE, label-free)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "min": 0.5,
          "max": 1.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 0.9}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ml_estimated_roc_auc{model=\"anomaly-detector\"}",
          "legendFormat": "estimated ROC AUC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Share of drifted features (Evidently)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {"min": 0, "max": 1},
        "overrides": []
      },
      "targets": [
        {
          "expr": "ml_drift_share{model=\"anomaly-detector\"}",
          "legendFormat": "drift share",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Per-feature drift score (Wasserstein, normed)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {"min": 0},
        "overrides": []
      },
      "targets": [
        {
          "expr": "ml_drift_score{model=\"anomaly-detector\"}",
          "legendFormat": "{{feature}}",
          "refId": "A"
        }
      ]
    }
  ]
}
